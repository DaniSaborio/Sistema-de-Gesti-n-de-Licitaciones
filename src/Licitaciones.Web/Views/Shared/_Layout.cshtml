<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Gestión de Licitaciones</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Gestión de Licitaciones</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal" aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarPrincipal">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Licitaciones" asp-action="Index">Licitaciones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Proveedores" asp-action="Index">Proveedores</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Ofertas" asp-action="Index">Ofertas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="NivelesAprobacion" asp-action="Index">Niveles de aprobación</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="TiposCambio" asp-action="Index">Tipo de cambio</a></li>
                        <li class="nav-item"><a class="nav-link" href="/docs/api" target="_blank" rel="noopener">API (Swagger)</a></li>
                    </ul>
                    <div class="d-flex gap-2">
                        <button id="toggle-moneda" type="button" class="btn btn-outline-secondary btn-sm" title="Alternar entre colones y dólares">₡ CRC</button>
                        <button id="toggle-tema" type="button" class="btn btn-outline-secondary btn-sm" title="Alternar modo claro/oscuro">🌙 Oscuro</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Exito"] is string mensajeExito)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensajeExito
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string mensajeError)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @mensajeError
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container">
            Sistema de Gestión de Licitaciones · Universidad Técnica Nacional · Proyecto Final XP
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
