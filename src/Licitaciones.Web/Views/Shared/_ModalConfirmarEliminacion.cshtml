<div class="modal fade" id="modal-confirmar-eliminacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="form-confirmar-eliminacion">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">¿Confirma que desea eliminar <strong id="modal-confirmar-eliminacion-nombre"></strong>? Esta acción no se puede deshacer desde la interfaz.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var modalElemento = document.getElementById('modal-confirmar-eliminacion');
        if (!modalElemento) { return; }
        modalElemento.addEventListener('show.bs.modal', function (evento) {
            var boton = evento.relatedTarget;
            var accion = boton.getAttribute('data-eliminar-url');
            var nombre = boton.getAttribute('data-eliminar-nombre');
            document.getElementById('form-confirmar-eliminacion').setAttribute('action', accion);
            document.getElementById('modal-confirmar-eliminacion-nombre').textContent = nombre;
        });
    })();
</script>
