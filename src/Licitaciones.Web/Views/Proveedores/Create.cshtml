@using Licitaciones.Web.Models.Proveedores
@model ProveedorFormViewModel
@{
    ViewData["Title"] = "Nuevo proveedor";
}

<h1 class="h3 mb-3">Nuevo proveedor</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" autofocus />
                <span asp-validation-for="Nombre" class="text-danger"></span>
                <div class="form-text">Letras, números, espacios, punto, coma y paréntesis.</div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
