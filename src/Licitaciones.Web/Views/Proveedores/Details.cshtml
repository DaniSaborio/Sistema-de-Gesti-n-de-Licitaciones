@using Licitaciones.Application.Proveedores
@model ProveedorDto
@{
    ViewData["Title"] = $"Proveedor — {Model.Nombre}";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.Nombre</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-body-secondary">Nombre</h2>
                <p class="mb-3">@Model.Nombre</p>
                <h2 class="h6 text-body-secondary">Registrado</h2>
                <p class="mb-0">@Model.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-body-secondary">Última actualización</h2>
                <p class="mb-0">@Model.UpdatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>
</div>