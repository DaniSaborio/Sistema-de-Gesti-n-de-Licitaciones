@using Licitaciones.Web.Models.NivelesAprobacion
@model NivelAprobacionFormViewModel
@{
    ViewData["Title"] = "Editar nivel de aprobación";
}

<h1 class="h3 mb-3">Editar nivel de aprobación</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="MontoMinimoCRC" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="MontoMinimoCRC" type="number" step="0.01" min="0.01" class="form-control" autofocus />
                </div>
                <span asp-validation-for="MontoMinimoCRC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MontoMaximoCRC" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="MontoMaximoCRC" type="number" step="0.01" min="0.01" class="form-control" />
                </div>
                <span asp-validation-for="MontoMaximoCRC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Aprobador" class="form-label"></label>
                <input asp-for="Aprobador" class="form-control" />
                <span asp-validation-for="Aprobador" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
