@using Licitaciones.Web.Models.Licitaciones
@model LicitacionFormViewModel
@{
    ViewData["Title"] = "Editar licitación";
}

<h1 class="h3 mb-3">Editar licitación @Model.Codigo</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Codigo" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label class="form-label">Código</label>
                <input class="form-control" value="@Model.Codigo" disabled />
                <div class="form-text">El código no se puede modificar una vez creada la licitación.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" autofocus />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FechaCierre" class="form-label"></label>
                <input asp-for="FechaCierre" type="datetime-local" class="form-control" />
                <span asp-validation-for="FechaCierre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PresupuestoEstimadoCRC" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="PresupuestoEstimadoCRC" type="number" step="0.01" min="0.01" class="form-control" />
                </div>
                <span asp-validation-for="PresupuestoEstimadoCRC" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
